# fwd — environment configuration
# Copy to .env and edit. .env is gitignored.

# ---------- fwd service ----------

# Image tag for the fwd container. Defaults to "dev" for local builds; CI sets a versioned tag.
FWD_IMAGE_TAG=dev

# URL of the Vault HTTP API (from inside the fwd-internal Docker network).
VAULT_ADDR=http://vault:8200

# Vault AppRole credentials for fwd → Vault auth.
# These are output by scripts/vault-init.sh after the operator runs the
# Shamir-unseal ritual. See docs/runbooks/vault-init.md.
# Both must be set for fwd to authenticate; Phase 3b lands the Vault client.
FWD_VAULT_ROLE_ID=
FWD_VAULT_SECRET_ID=

# RPC URLs for the supported chains. Phase 2 doesn't actually call these; Phase 3 onwards does.
RPC_URL_FLARE=https://flare-api.flare.network/ext/C/rpc
RPC_URL_SONGBIRD=https://songbird-api.flare.network/ext/C/rpc
RPC_URL_COSTON2=https://coston2-api.flare.network/ext/C/rpc

# Admin bearer key for /v1/admin/* endpoints. Phase 2 doesn't expose admin endpoints yet;
# Phase 4 will. Generate a random ≥32-char string for production.
# FWD_ADMIN_KEY=

# Logging level: DEBUG, INFO, WARNING, ERROR. Default INFO.
FWD_LOG_LEVEL=INFO

# ---------- Litestream (Phase 6: real S3 backup) ----------

# Scaleway Object Storage credentials.
#
# Provision a bucket in the Scaleway console:
#   1. Region: fr-par (recommended — closest to ap-ftso-* hosts).
#   2. Bucket name: ap-fwd-backups (or similar; matches LITESTREAM_S3_BUCKET).
#   3. Visibility: PRIVATE (default).
#   4. Generate an access key + secret for an IAM user with write access to
#      the bucket. Capture both — Scaleway only shows the secret ONCE.
#
# These values are NOT in the public repo — populate from your local copy.
# Loss of access = loss of the backup path until reprovisioned. Treat as
# secrets equivalent to FWD_VAULT_SECRET_ID.

LITESTREAM_S3_ENDPOINT=https://s3.fr-par.scw.cloud
LITESTREAM_S3_BUCKET=ap-fwd-backups
LITESTREAM_S3_REGION=fr-par
LITESTREAM_S3_ACCESS_KEY_ID=
LITESTREAM_S3_SECRET_ACCESS_KEY=

# Per-host subpath within the bucket. Default "state.db" works for
# single-host deployments; for multi-host (e.g., one fwd per ap-ftso-* box),
# override per-host (e.g., LITESTREAM_S3_PATH=ap-ftso-02/state.db).
# LITESTREAM_S3_PATH=state.db

# Retention window for snapshots. Default 72h keeps 3 daily snapshots.
# Extend if your DR window is longer (e.g., 168h = 1 week).
# LITESTREAM_RETENTION=72h

# ---------- vault-snapshot (Phase 6: Vault Raft snapshot to S3) ----------

# AppRole credentials for the vault-snapshot sidecar. Output by the
# extended scripts/vault-init.sh (steps 11-12). Both must be set for the
# sidecar to authenticate; missing values cause a login failure logged
# once per VAULT_SNAPSHOT_INTERVAL_SEC iteration (loop continues).
FWD_VAULT_SNAPSHOT_ROLE_ID=
FWD_VAULT_SNAPSHOT_SECRET_ID=

# S3 prefix within LITESTREAM_S3_BUCKET for Vault snapshots. Default
# `vault-snapshots` puts them at s3://<bucket>/vault-snapshots/vault-<ts>.snap.
# For multi-host deployments override per-host (e.g. `ap-ftso-02/vault-snapshots`).
# VAULT_SNAPSHOT_S3_PATH=vault-snapshots

# Snapshot cadence. Default 86400s = 24h (matches implementation-plan.md
# Phase 6 "nightly"). Lower (e.g. 300) for testing/drill validation.
# VAULT_SNAPSHOT_INTERVAL_SEC=86400

# Retention: keep the newest N snapshots; delete the rest after each
# successful upload. Default 7 (one week of nightlies).
# VAULT_SNAPSHOT_RETENTION_COUNT=7
