# fwd — environment configuration
# Copy to .env and edit. .env is gitignored.

# ---------- fwd service ----------

# Image tag for the fwd container. Defaults to "dev" for local builds; CI sets a versioned tag.
FWD_IMAGE_TAG=dev

# URL of the Vault HTTP API (from inside the fwd-internal Docker network).
VAULT_ADDR=http://vault:8200

# Vault AppRole credentials for fwd → Vault auth.
# These are output by scripts/vault-init.sh after the operator runs the
# Shamir-unseal ritual. See docs/runbooks/vault-init.md.
# Both must be set for fwd to authenticate; Phase 3b lands the Vault client.
FWD_VAULT_ROLE_ID=
FWD_VAULT_SECRET_ID=

# RPC URLs for the supported chains. Phase 2 doesn't actually call these; Phase 3 onwards does.
RPC_URL_FLARE=https://flare-api.flare.network/ext/C/rpc
RPC_URL_SONGBIRD=https://songbird-api.flare.network/ext/C/rpc
RPC_URL_COSTON2=https://coston2-api.flare.network/ext/C/rpc

# Admin bearer key for /v1/admin/* endpoints. Phase 2 doesn't expose admin endpoints yet;
# Phase 4 will. Generate a random ≥32-char string for production.
# FWD_ADMIN_KEY=

# Logging level: DEBUG, INFO, WARNING, ERROR. Default INFO.
FWD_LOG_LEVEL=INFO

# ---------- Phase 7 policy (lands at v0.5.0a5 — integration ship) ----------

# Path to the YAML policy file consumed by the Phase 7 policy engine.
# See decisions.md D13/D14 + architecture.md § Policy YAML format for the
# schema. The file is operator-controlled and gitignored; mount it via
# docker-compose volume bind. Pre-v0.5.0a5: unused.
FWD_POLICY_PATH=/etc/fwd/policy.yaml

# ---------- backup (Phase 6: local replica + Vault Raft snapshot) ----------

# Both Litestream (SQLite state.db replica) and the vault-snapshot sidecar
# (Vault Raft snapshots) write into the shared `backup` Docker volume
# mounted at /backup. No cloud credentials. No external service.
#
# Off-host transport (rsync / restic / borg / NAS / USB — whatever fits the
# deployment) is the operator's responsibility, run out-of-band against
# this volume. fwd does not transport backups off-host. See
# docs/runbooks/restore.md for the local restore procedure.
#
# For production deployments where the operator wants a host-path bind
# instead of a Docker-managed named volume, override the `backup:` volume
# definition in docker-compose.yml (or via an override compose file).

# AppRole credentials for the vault-snapshot sidecar. Output by the
# extended scripts/vault-init.sh (steps 11-12). Both must be set for the
# sidecar to authenticate; missing values cause a login failure logged
# once per VAULT_SNAPSHOT_INTERVAL_SEC iteration (loop continues).
FWD_VAULT_SNAPSHOT_ROLE_ID=
FWD_VAULT_SNAPSHOT_SECRET_ID=

# Snapshot cadence. Default 86400s = 24h (matches implementation-plan.md
# Phase 6 "nightly"). Lower (e.g. 300) for drill validation.
# VAULT_SNAPSHOT_INTERVAL_SEC=86400

# Retention: keep the newest N snapshot files in /backup/vault-snapshots/;
# delete the rest after each successful save. Default 7 (one week of nightlies).
# VAULT_SNAPSHOT_RETENTION_COUNT=7
