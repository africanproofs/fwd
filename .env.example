# fwd — environment configuration
# Copy to .env and edit. .env is gitignored.

# ---------- fwd service ----------

# Image tag for the fwd container. Defaults to "dev" for local builds; CI sets a versioned tag.
FWD_IMAGE_TAG=dev

# Sealed-master custody. Path to the 32-byte AES-256-GCM master key file.
# It MUST be mode 0600 and owned by the uid fwd runs as (uid 1000 in the
# container). Generate it with `clifwd master generate`. It is
# policy.yaml-class private config (Core invariant #12): gitignored, never
# in the repo or image, operator-provisioned, bind-mounted into the
# container at this path.
FWD_MASTER_KEY_FILE=/run/fwd/master.key

# Admin bearer key for /v1/admin/* endpoints.
# Generate a random ≥32-char string for production.
# FWD_ADMIN_KEY=

# Zero-egress sanity caps. fwd makes no RPC call; the client supplies gas +
# fees. These caps bound what fwd will accept.
# FWD_MAX_GAS=15000000
# FWD_MAX_FEE_PER_GAS=500000000000

# Logging level: DEBUG, INFO, WARNING, ERROR. Default INFO.
FWD_LOG_LEVEL=INFO

# ---------- policy ----------

# Path to the YAML policy file consumed by the policy engine.
# See architecture.md § Policy YAML format for the schema. The file is
# operator-controlled and gitignored; mount it via docker-compose volume
# bind.
FWD_POLICY_PATH=/etc/fwd/policy.yaml

# ---------- backup (local replica only) ----------

# Litestream replicates the SQLite state.db into the shared `backup`
# Docker volume mounted at /backup. No cloud credentials, no external
# service — the sealed master is a single mode-0600 host file the operator
# backs up out-of-band alongside this volume.
#
# Off-host transport (rsync / restic / borg / NAS / USB — whatever fits
# the deployment) is the operator's responsibility, run out-of-band
# against this volume AND the FWD_MASTER_KEY_FILE above. fwd does not
# transport backups off-host.
#
# For production deployments where the operator wants a host-path bind
# instead of a Docker-managed named volume, override the `backup:` volume
# definition in docker-compose.yml (or via an override compose file).
