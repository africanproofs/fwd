#!/bin/sh
# Host `clifwd` wrapper — delegates the application CLI into the running fwd
# container, so the CLI runs against the same Python package, mounted state,
# policy.yaml, and sealed-master custody as the daemon.
#
# Installed to /usr/local/bin/clifwd by install.sh. Normal usage:
#   clifwd health
#   clifwd policy init --networks flare,songbird --recipient 0x...
#   clifwd policy validate
#   clifwd wallets import --name ... --privkey-file /path/in/container ...
#   clifwd audit verify
#
# NOTE: file paths (e.g. --privkey-file) are evaluated INSIDE the container.
#
# Stack onboarding (fwd custody provisioning + writing clif's env config) is a
# HOST-level operation. The canonical entry point is `fwd onboard`; `clifwd onboard`
# is a compatibility alias that routes to the same host orchestrator below. Neither
# the in-container CLI nor a compose service can orchestrate `docker compose restart`
# or write the host policy file — both run on the host.
set -eu

export FWD_DIR="${FWD_DIR:-/opt/fwd}"
export FWD_CONTAINER="${FWD_CONTAINER:-fwd}"
# Pin project = container so onboard (routed below) operates the installer's project,
# immune to a stale COMPOSE_PROJECT_NAME in the operator's shell.
export COMPOSE_PROJECT_NAME="${FWD_CONTAINER:-fwd}"

if [ "${1:-}" = "onboard" ]; then
  shift
  exec "$FWD_DIR/install/onboard" "$@"
fi

exec docker exec -i "${FWD_CONTAINER:-fwd}" clifwd "$@"
