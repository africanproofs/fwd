#!/bin/sh
# clifwd onboard — guided, single-terminal reward-onboarding wizard.
#
# Surfaced as `clifwd onboard rewards [fsp|validator]` (the clifwd host wrapper
# routes `onboard` here), and run by default at install time. Class `fsp`
# (default) sets up the two revenue operations — claiming FTSO rewards
# (RewardManager.claim) and signing FSP rewards (signUptimeVote / signRewards):
# it generates the reward policy, loads it, provisions the wallets fwd signs
# from, mints the caller tokens your client (clif) uses, seeds the sender nonces,
# and narrates every step. Class `validator` (staking/validator rewards) is a
# future class — reserved, not yet implemented.
#
# Wallets: by default the executor + sender are GENERATED fresh inside fwd's
# sealed vault (their private keys never exist outside it). `--import-existing`
# imports your existing executor + sender instead (migration) — prompting each
# sender's real on-chain nonce and printing a cutover checklist. The FSP signing
# key is always imported (it must match the key Flare has registered for you).
#
# Single terminal: all prompts read from /dev/tty (so it works even under
# `curl|sh`). Importing a key: you PASTE it (hidden); fwd pipes it straight into
# the daemon container, seals it under the master, and shreds the transient input
# — the key never touches this host's disk and never leaves the box.
#
# Idempotent: re-running skips wallets/callers/nonces that already exist and skips
# the restart if the policy is byte-identical.
#
# Honors $FWD_DIR (the compose bundle + mounted config/policy.yaml) and
# $FWD_CONTAINER (the daemon container). Admin commands run in-container, where
# FWD_ADMIN_KEY lives.
set -eu

FWD_DIR="${FWD_DIR:-/opt/fwd}"
FWD_CONTAINER="${FWD_CONTAINER:-fwd}"
POLICY="$FWD_DIR/config/policy.yaml"

clifwd() { docker exec "$FWD_CONTAINER" clifwd "$@"; }
die()  { printf '\033[1;31monboard:\033[0m %s\n' "$*" >&2; exit 1; }
note() { printf '   \033[1;36m·\033[0m %s\n' "$*"; }
warn() { printf '   \033[1;33m! %s\033[0m\n' "$*" >&2; }

STEP=0
step() {  # title [explanation]
  STEP=$((STEP + 1))
  printf '\n\033[1;36m── Step %s — %s\033[0m\n' "$STEP" "$1"
  [ -n "${2:-}" ] && printf '   %s\n' "$2"
  return 0
}

# Single-terminal I/O: read from the controlling terminal, not stdin (which under
# `curl|sh` is the piped script). TTY_OK gates interactive prompts.
TTY_OK=0
if { true >/dev/tty; } 2>/dev/null; then TTY_OK=1; fi
ask_tty() {  # prompt -> REPLY (visible)
  [ "$TTY_OK" -eq 1 ] || { REPLY=""; return 1; }
  printf '%s' "$1" >/dev/tty
  IFS= read -r REPLY </dev/tty || REPLY=""
}
ask_secret() {  # prompt -> SECRET (hidden; echo OFF before the prompt to avoid an echo race)
  [ "$TTY_OK" -eq 1 ] || { SECRET=""; return 1; }
  stty -echo </dev/tty 2>/dev/null || true
  printf '%s' "$1" >/dev/tty
  IFS= read -r SECRET </dev/tty || SECRET=""
  stty echo </dev/tty 2>/dev/null || true
  printf '\n' >/dev/tty
}

usage() {
  cat >&2 <<EOF
usage: clifwd onboard rewards [fsp|validator] [--recipient 0xADDR] [options]

  Guided single-terminal wizard. Prompts (on the terminal) for your recipient
  and, at the import step, for each private key (pasted, hidden).

  fsp                    (default) FTSO claim + FSP signing provider rewards
  validator              staking/validator rewards — future class (not yet supported)
  --recipient 0xADDR     claim reward destination (prompted if omitted)
  --networks  LIST       comma-separated (default: coston2)
  --import-existing      import your existing executor + sender keys (migration)
                         instead of generating fresh ones; prompts each real nonce
  --claim-only           policy + wallets for claiming only
  --sign-only            policy + wallets for FSP signing only
  --skip-fsp-import      skip the key-paste gate (defer imports)
EOF
  exit 2
}

# ---- arg parse ----
MODE="${1:-}"; [ "$#" -gt 0 ] && shift
[ "$MODE" = "rewards" ] || usage

# Optional reward class: fsp (default, today) | validator (future).
CLASS=fsp
case "${1:-}" in
  fsp|validator) CLASS="$1"; shift ;;
esac
if [ "$CLASS" = validator ]; then
  echo "onboard: validator reward onboarding is a future class — not yet supported." >&2
  echo "         today: clifwd onboard rewards fsp --recipient 0xADDR [--networks ...]" >&2
  exit 2
fi

NETS="coston2"; RECIP=""; CAPS="claim,fsp"; SKIP_FSP_IMPORT=0; IMPORT_EXISTING=0
while [ "$#" -gt 0 ]; do
  case "$1" in
    --recipient)       RECIP="${2:-}"; shift 2 ;;
    --networks)        NETS="${2:-}"; shift 2 ;;
    --claim-only)      CAPS="claim"; shift ;;
    --sign-only)       CAPS="fsp"; shift ;;
    --skip-fsp-import) SKIP_FSP_IMPORT=1; shift ;;
    --import-existing) IMPORT_EXISTING=1; shift ;;
    -h|--help)         usage ;;
    *)                 die "unknown arg: $1 (try --help)" ;;
  esac
done

case ",$CAPS," in *,claim,*) HAS_CLAIM=1 ;; *) HAS_CLAIM=0 ;; esac
case ",$CAPS," in *,fsp,*)   HAS_FSP=1   ;; *) HAS_FSP=0   ;; esac
[ -d "$FWD_DIR/config" ] || die "no $FWD_DIR/config — set FWD_DIR to the compose bundle"

# Recipient: prompt if claiming and not supplied.
if [ "$HAS_CLAIM" -eq 1 ] && [ -z "$RECIP" ]; then
  if ask_tty "Your claim reward recipient address (0x..): " && [ -n "$REPLY" ]; then
    RECIP="$REPLY"
  else
    die "--recipient is required when claiming (or use --sign-only)"
  fi
fi
if [ "$HAS_CLAIM" -eq 1 ]; then
  case "$RECIP" in 0x[0-9a-fA-F]*) : ;; *) die "recipient must be a 0x.. hex address (got: $RECIP)" ;; esac
fi

NETLIST="$(echo "$NETS" | tr ',' ' ')"

# Resolve a network's chain id from the SAME networks.yaml the generator used
# (baked in-container; honors an FWD_NETWORKS_FILE override) — no host-side drift.
chain_of() {
  docker exec "$FWD_CONTAINER" python -c \
    'import os,sys,yaml;p=os.environ.get("FWD_NETWORKS_FILE","/app/config/networks.yaml");print(yaml.safe_load(open(p))[sys.argv[1]]["chain_id"])' \
    "$1"
}

printf '\033[1;36m=== fwd reward onboarding (%s) ===\033[0m\n' "$CLASS"
printf 'Setting up %s on networks: %s.\n' \
  "$( [ "$HAS_CLAIM" -eq 1 ] && [ "$HAS_FSP" -eq 1 ] && echo 'fee claiming + FSP reward signing' || { [ "$HAS_CLAIM" -eq 1 ] && echo 'fee claiming' || echo 'FSP reward signing'; } )" \
  "$NETS"

# ---- Step 1: preflight ----
step "Checking fwd" "It must be running and sealed before we configure it."
clifwd health >/dev/null 2>&1 || die "fwd not healthy (is container '$FWD_CONTAINER' up? try: sudo fwd start)"
note "healthy"

# ---- Step 2: build the reward policy ----
step "Building your reward policy" \
  "The allow-list of exactly what fwd may sign — RewardManager.claim (claiming) and FlareSystemsManager signUptimeVote/signRewards (FSP). Your recipient is pinned, so a claim can only ever pay you."
TMP="$(mktemp "${TMPDIR:-/tmp}/fwd-onboard-policy.XXXXXX")"
trap 'rm -f "$TMP"' EXIT INT TERM
set +e
if [ "$HAS_CLAIM" -eq 1 ]; then
  clifwd policy init --networks "$NETS" --capabilities "$CAPS" --recipient "$RECIP" > "$TMP"
else
  clifwd policy init --networks "$NETS" --capabilities "$CAPS" > "$TMP"
fi
rc=$?
set -e
{ [ "$rc" -eq 0 ] && [ -s "$TMP" ]; } || die "policy init failed (exit $rc) — nothing written, existing policy untouched"

# Write in place (only if changed). A single-file bind mount pins the inode:
# overwrite in place (cat > file keeps the inode) so the container sees the new
# content live; `mv` would NOT be seen until restart.
BAK=""
if [ -f "$POLICY" ] && cmp -s "$TMP" "$POLICY"; then
  CHANGED=0
  note "policy is byte-identical to the current one — no change"
else
  CHANGED=1
  if [ -f "$POLICY" ]; then
    BAK="$POLICY.bak-pre-onboard-$(date +%Y%m%d-%H%M%S)"
    cp "$POLICY" "$BAK"
    note "backed up the existing policy -> $BAK"
  fi
  cat "$TMP" > "$POLICY"
  note "wrote $POLICY"
fi
rm -f "$TMP"; trap - EXIT INT TERM
clifwd policy validate --schema-only >/dev/null || {
  warn "schema validation FAILED — the new policy was NOT loaded."
  [ -n "$BAK" ] && { cat "$BAK" > "$POLICY"; warn "restored prior policy from $BAK"; }
  die "aborting before restart"
}
note "policy validates"

# ---- Step 3: load the policy ----
step "Loading the policy" "fwd boots inert (signs nothing); it reads the policy at startup, so we restart it to apply the allow-list."
if [ "$CHANGED" -eq 1 ]; then
  ( cd "$FWD_DIR"
    COMPOSE="-f docker-compose.yml"
    [ -f docker-compose.clif.yml ] && COMPOSE="$COMPOSE -f docker-compose.clif.yml"
    docker compose $COMPOSE restart fwd >/dev/null ) || die "restart failed"
  i=0; while [ "$i" -lt 20 ]; do
    st="$(docker inspect -f '{{.State.Health.Status}}' "$FWD_CONTAINER" 2>/dev/null || echo starting)"
    [ "$st" = healthy ] && break
    i=$((i + 1)); sleep 3
  done
  clifwd health >/dev/null 2>&1 || {
    warn "fwd did not return healthy after restart."
    [ -n "$BAK" ] && warn "restore: cat '$BAK' > '$POLICY' && sudo fwd restart"
    die "health check failed post-restart"
  }
  note "loaded (fwd restarted, healthy)"
else
  note "already loaded — skipping restart"
fi

# ---- Step 4: provision the wallets fwd signs from ----
# fsp-signing-<net> is operator-imported in BOTH modes (it must be the registered
# key). --import-existing additionally imports the executor + sender instead of
# generating them. IMPORT_LIST = space-separated "name:policy" tokens.
wallet_create() {
  set +e; out="$(clifwd wallets create --name "$1" --policy "$2" 2>&1)"; rc=$?; set -e
  case "$rc" in
    0) note "generated in-vault: $1" ;;
    3) note "exists (skip): $1" ;;
    *) die "wallets create $1 failed: $out" ;;
  esac
}
wallet_exists() { clifwd wallets list 2>/dev/null | awk '{print $1}' | grep -qx "$1"; }

IMPORT_LIST=""
add_import() { IMPORT_LIST="$IMPORT_LIST $1:$2"; }

if [ "$IMPORT_EXISTING" -eq 1 ]; then
  step "Preparing wallets (import-existing)" "You'll provide your existing executor + signing + sender keys at the next step — nothing is generated."
  for net in $NETLIST; do
    [ "$HAS_CLAIM" -eq 1 ] && add_import "claimer-$net" "wc/claimer-$net"
    [ "$HAS_FSP" -eq 1 ]   && add_import "fsp-signing-$net" "wc/fsp-$net"
  done
  [ "$HAS_FSP" -eq 1 ] && add_import "fsp-sender" "wc/fsp-sender"
else
  step "Preparing wallets" "Generating fresh keys inside fwd's sealed vault — the private keys never exist outside it. (Your registered FSP signing key is imported at the next step.)"
  for net in $NETLIST; do
    [ "$HAS_CLAIM" -eq 1 ] && wallet_create "claimer-$net" "wc/claimer-$net"
  done
  [ "$HAS_FSP" -eq 1 ] && wallet_create "fsp-sender" "wc/fsp-sender"   # shared across networks
  for net in $NETLIST; do
    [ "$HAS_FSP" -eq 1 ] && add_import "fsp-signing-$net" "wc/fsp-$net"
  done
fi

# ---- Step 5: GATE 1 — paste your key(s) ----
# Paste reaches the in-container importer via a 0600 fwd-owned temp + --shred-source;
# never on host disk, never on the network.
import_pasted() {  # name policy
  if wallet_exists "$1"; then note "already imported: $1"; return 0; fi
  if [ "$SKIP_FSP_IMPORT" -eq 1 ]; then
    warn "deferred (--skip-fsp-import) $1 — import later: clifwd wallets import --name $1 --policy $2 --privkey-file <file>"
    return 0
  fi
  if [ "$TTY_OK" -ne 1 ]; then
    warn "no terminal to paste $1 — import later: clifwd wallets import --name $1 --policy $2 --privkey-file <file>"
    return 0
  fi
  _hint=""
  case "$1" in fsp-signing-*) _hint=" (your REGISTERED signing-policy key)" ;; esac
  ask_secret "  paste the private key for $1$_hint (hex, hidden) — or press Enter to skip: "
  if [ -z "$SECRET" ]; then
    warn "skipped $1 — import later: clifwd wallets import --name $1 --policy $2 --privkey-file <file>"
    return 0
  fi
  if ! printf '%s' "$SECRET" | tr -d ' \t\r\n' | sed 's/^0[xX]//' \
       | docker exec -i "$FWD_CONTAINER" sh -c 'umask 077; cat > /tmp/.fwd-onboard.key'; then
    SECRET=''; unset SECRET
    warn "could not stage the $1 key into the container — skipped"
    return 0
  fi
  SECRET=''; unset SECRET
  set +e; out="$(clifwd wallets import --name "$1" --policy "$2" --privkey-file /tmp/.fwd-onboard.key --shred-source 2>&1)"; rc=$?; set -e
  docker exec "$FWD_CONTAINER" sh -c 'rm -f /tmp/.fwd-onboard.key' 2>/dev/null || true
  case "$rc" in
    0) note "imported + sealed: $1 (pasted input shredded)" ;;
    3) note "already imported (skip): $1" ;;
    *) warn "import $1 FAILED: $out — retry: clifwd wallets import --name $1 --policy $2 --privkey-file <file>" ;;
  esac
}
if [ -n "$IMPORT_LIST" ]; then
  step "Importing your key(s)" "Paste each key (hidden). fwd seals it under its master key and shreds the input — the key never touches this host's disk and never leaves the box."
  for tok in $IMPORT_LIST; do
    import_pasted "${tok%%:*}" "${tok#*:}"
  done
fi

# ---- Step 6: caller tokens (each shown ONCE) ----
caller_create() {
  set +e; key="$(clifwd callers create --name "$1" --policy "$2" 2>/dev/null)"; rc=$?; set -e
  case "$rc" in
    0) printf '   \033[1;32mTOKEN (shown ONCE)\033[0m %-18s -> clif API key for this caller\n     %s\n' "$1" "$key" ;;
    3) warn "caller exists (skip): $1 — token was shown once and can't be re-displayed; revoke+recreate if lost: clifwd callers revoke --name $1" ;;
    *) die "callers create $1 failed (exit $rc)" ;;
  esac
  unset key
}
step "Minting access tokens" "These bearer tokens are what your claim/FSP client (clif) uses to ask fwd to sign. Shown ONCE — copy them into clif's .env now."
for net in $NETLIST; do
  [ "$HAS_CLAIM" -eq 1 ] && caller_create "claim-$net" "perm/claim-$net"
  if [ "$HAS_FSP" -eq 1 ]; then
    caller_create "fsp-sign-$net"   "fsp/$net"
    caller_create "fsp-submit-$net" "perm/fsp-submit-$net"
  fi
done

# ---- Step 7: seed sender nonces ----
nonce_seed() {  # name chain starting_nonce
  set +e; out="$(clifwd nonce init --wallet "$1" --chain "$2" --starting-nonce "$3" 2>&1)"; rc=$?; set -e
  if [ "$rc" -eq 0 ]; then note "nonce seeded: $1 @ chain $2 = $3"
  elif printf '%s' "$out" | grep -q nonce_already_initialized; then note "nonce exists (skip): $1 @ chain $2"
  else die "nonce init $1/$2 failed: $out"
  fi
}
ask_nonce() {  # name -> echoes the starting nonce to stdout
  if [ "$IMPORT_EXISTING" -eq 1 ] && [ "$TTY_OK" -eq 1 ]; then
    ask_tty "  current on-chain nonce (tx count) for imported $1 [default 0]: "
    if [ -z "$REPLY" ]; then
      warn "no nonce for $1 — using 0 (fix via nonce-sync if the key has already sent txs)"; printf '0'
    else
      printf '%s' "$REPLY"
    fi
  else
    printf '0'
  fi
}
step "Seeding transaction counters" "fwd is offline (it never reads the chain), so each sending wallet needs its next nonce. Fresh wallets start at 0; imported keys use their current on-chain count."
for net in $NETLIST; do
  cid="$(chain_of "$net")" || die "could not resolve chain id for '$net'"
  senders=""
  [ "$HAS_CLAIM" -eq 1 ] && senders="$senders claimer-$net"
  [ "$HAS_FSP" -eq 1 ]   && senders="$senders fsp-sender"
  for s in $senders; do
    if wallet_exists "$s"; then
      nonce_seed "$s" "$cid" "$(ask_nonce "$s")"
    else
      warn "$s not present (import deferred) — after importing: clifwd nonce init --wallet $s --chain $cid --starting-nonce <n>"
    fi
  done
done

# ---- Step 8: GATE 2 — on-chain (operator-only, offline identity key) ----
step "On-chain authorization (your last step)" "fwd is now configured. This final step is on-chain and uses your OFFLINE identity key — fwd never holds it."
printf '\n=============================================================================\n'
if [ "$IMPORT_EXISTING" -eq 1 ]; then
  printf '\033[1;31mCUTOVER\033[0m — Your imported keys are already authorized/registered on-chain, so\n'
  printf 'no new authorization is needed. Instead:\n'
  for net in $NETLIST; do
    printf '  [%s]\n' "$net"
    [ "$HAS_CLAIM" -eq 1 ] && printf '    STOP the old claimer for claimer-%s — fwd is now its sole user\n' "$net"
    [ "$HAS_FSP" -eq 1 ]   && printf '    STOP the old submitter for fsp-sender / fsp-signing-%s (sole-submitter cutover)\n' "$net"
    [ "$HAS_CLAIM" -eq 1 ] && printf '    verify %s is still an allowed claim recipient\n' "$RECIP"
  done
  printf 'If the old flare-system-client / ftso-fee-claimer keeps submitting from these\n'
  printf 'accounts, it and fwd will collide on nonces — stop it first.\n'
else
  printf '\033[1;31mAUTHORIZE\033[0m — from your OFFLINE identity key (fwd never custodies it):\n'
  for net in $NETLIST; do
    printf '  [%s]\n' "$net"
    if [ "$HAS_CLAIM" -eq 1 ]; then
      printf '    ClaimSetupManager.setClaimExecutors  -> authorize claimer-%s\n' "$net"
      printf '    setAllowedClaimRecipients            -> allow %s\n' "$RECIP"
    fi
    [ "$HAS_FSP" -eq 1 ] && printf '    FSP signing-policy registration      -> register fsp-signing-%s as a voter\n' "$net"
  done
fi
printf '\nThen rehearse a real claim + FSP sign on Coston2 through clif, verify the\n'
printf "RewardClaimed event on-chain and 'clifwd audit verify', before mainnet.\n"
printf 'Full detail: docs/one-command-install.md\n'
printf '=============================================================================\n'
printf '\n\033[1;32m✓ onboard complete\033[0m — policy loaded; wallets/callers/nonces ready. The on-chain step above is yours.\n'
