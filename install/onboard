  printf '\033[1;31mon-chain authorization required\033[0m — from your OFFLINE identity key (fwd never holds it):\n'
  for net in $NETLIST; do
    printf '  [%s]\n' "$net"
    if [ "$HAS_CLAIM" -eq 1 ]; then
      printf '    claim executor: %s (%s)\n' "claimer-$net" "$(wallet_addr "claimer-$net")"
      printf '                    authorize via ClaimSetupManager.setClaimExecutors\n'
      printf '    recipient:      %s\n' "$RECIP"
      printf '                    allow via setAllowedClaimRecipients\n'
    fi
