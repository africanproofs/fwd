#!/bin/sh
# clifwd onboard — guided, single-terminal reward-onboarding wizard.
#
# Surfaced as `clifwd onboard rewards [fsp|validator]` (the clifwd host wrapper
# routes `onboard` here), and run by default at install time. Class `fsp`
# (default) sets up the two revenue operations — claiming FTSO rewards
# (RewardManager.claim) and signing FSP rewards (signUptimeVote / signRewards):
# it generates the reward policy, loads it, then provisions each function in its
# own clearly-demarcated section (wallets, caller tokens, nonces), echoing every
# wallet's address, and ends with the on-chain step. Class `validator`
# (staking/validator rewards) is a future class — reserved, not yet implemented.
#
# Wallets: by default the executor + sender are GENERATED fresh inside fwd's
# sealed vault (their private keys never exist outside it). `--import-existing`
# imports your existing executor + sender instead (migration cutover checklist).
# The FSP signing key is always imported (it must match the key Flare has
# registered for you). Nonces are read from chain truth via the keyless clif
# one-shot (egress stays in clif; fwd has no egress) — no hand-typing required.
#
# clif runtime config: onboard writes clif's per-network .env.<net> files as a
# first-class step, capturing caller tokens and wallet names. The FSP gas-paying
# sender defaults to per-network (fsp-sender-<net>).
#
# Single terminal: all prompts read from /dev/tty (so it works even under
# `curl|sh`). Importing a key: you PASTE it (hidden); fwd pipes it straight into
# the daemon container, seals it under the master, and shreds the transient input
# — the key never touches this host's disk and never leaves the box.
#
# Idempotent: re-running skips wallets/callers/nonces that already exist and skips
# the restart if the policy is byte-identical.
#
# Honors $FWD_DIR (the compose bundle + mounted config/policy.yaml) and
# $FWD_CONTAINER (the daemon container). Admin commands run in-container, where
# FWD_ADMIN_KEY lives.
set -eu

FWD_DIR="${FWD_DIR:-/opt/fwd}"
FWD_CONTAINER="${FWD_CONTAINER:-fwd}"
POLICY="$FWD_DIR/config/policy.yaml"

clifwd() { docker exec "$FWD_CONTAINER" clifwd "$@"; }
die()  { printf '\033[1;31monboard:\033[0m %s\n' "$*" >&2; exit 1; }
note() { printf '   \033[1;36m·\033[0m %s\n' "$*"; }
warn() { printf '   \033[1;33m! %s\033[0m\n' "$*" >&2; }

# Output mode: compact (default — operator cockpit) | guided (verbose, first-timer).
# Safety warnings/confirmations/prompts print in BOTH modes; only explanation is gated.
# guided's first arg is a printf FORMAT (callers may pass %s + args); a literal % must be %%.
case "${FWD_OUTPUT:-compact}" in guided) OUTPUT=guided ;; *) OUTPUT=compact ;; esac
guided() { [ "$OUTPUT" = guided ] && printf "$@"; return 0; }

STEP=0
step() {  # title [explanation]
  STEP=$((STEP + 1))
  printf '\n\033[1;36m── Step %s — %s\033[0m\n' "$STEP" "$1"
  [ "$OUTPUT" = guided ] && [ -n "${2:-}" ] && printf '   %s\n' "$2"
  return 0
}
FN=0
fsection() {  # title [explanation] — a clearly-demarcated per-function section
  FN=$((FN + 1))
  printf '\n\033[1;35m═══════════════ Function %s/%s — %s ═══════════════\033[0m\n' "$FN" "$NFUNC" "$1"
  [ "$OUTPUT" = guided ] && [ -n "${2:-}" ] && printf '   %s\n' "$2"
  return 0
}

# Single-terminal I/O: read from the controlling terminal, not stdin (which under
# `curl|sh` is the piped script). TTY_OK gates interactive prompts.
TTY_OK=0
if { true >/dev/tty; } 2>/dev/null; then TTY_OK=1; fi
ask_tty() {  # prompt -> REPLY (visible)
  [ "$TTY_OK" -eq 1 ] || { REPLY=""; return 1; }
  printf '%s' "$1" >/dev/tty
  IFS= read -r REPLY </dev/tty || REPLY=""
}
ask_secret() {  # prompt -> SECRET (hidden; echo OFF before the prompt to avoid an echo race)
  [ "$TTY_OK" -eq 1 ] || { SECRET=""; return 1; }
  stty -echo </dev/tty 2>/dev/null || true
  printf '%s' "$1" >/dev/tty
  IFS= read -r SECRET </dev/tty || SECRET=""
  stty echo </dev/tty 2>/dev/null || true
  printf '\n' >/dev/tty
}

usage() {
  cat >&2 <<EOF
usage: clifwd onboard rewards [fsp|validator] [--recipient 0xADDR] [options]

  Guided single-terminal wizard, organized by function (fee claiming, FSP reward
  signing). Prompts (on the terminal) for your recipient and, in each function's
  section, for the private key(s) it needs (pasted, hidden).

  fsp                    (default) FTSO claim + FSP signing provider rewards
  validator              staking/validator rewards — future class (not yet supported)
  --recipient 0xADDR     claim reward destination (prompted if omitted)
  --networks  LIST       comma-separated (default: songbird; flare for mainnet,
                         coston2 only if you're a registered voter there)
  --import-existing      import your existing executor + sender keys (migration)
                         instead of generating fresh ones; prompts each real nonce
  --claim-only           policy + wallets for claiming only
  --sign-only            policy + wallets for FSP signing only
  --skip-fsp-import      skip the key-paste gates (defer imports)
      --identity 0xADDR      reward owner / data-provider identity (required for claiming;
                             written to clif as IDENTITY_ADDRESS)
      --fsp-sender MODE      per-network (default; fsp-sender-<net>) | shared (one fsp-sender)
      --accept-pending-nonces  seed to the PENDING nonce when pending > latest (cutover)
      --rotate-missing-callers revoke + re-mint a caller whose one-time token is lost and
                             absent from the clif env (otherwise onboard stops)
      --show-secrets         print caller tokens to the terminal (default: written to env only)
      --guided | --explain   verbose, explanatory output (default: compact; env: FWD_OUTPUT=guided)
EOF
  exit 2
}

# ---- arg parse ----
MODE="${1:-}"; [ "$#" -gt 0 ] && shift
[ "$MODE" = "rewards" ] || usage

# Optional reward class: fsp (default, today) | validator (future).
CLASS=fsp
case "${1:-}" in
  fsp|validator) CLASS="$1"; shift ;;
esac
if [ "$CLASS" = validator ]; then
  echo "onboard: validator reward onboarding is a future class — not yet supported." >&2
  echo "         today: clifwd onboard rewards fsp --recipient 0xADDR [--networks ...]" >&2
  exit 2
fi

NETS="songbird"; RECIP=""; CAPS="claim,fsp"; SKIP_FSP_IMPORT=0; IMPORT_EXISTING=0
IDENTITY=""; FSP_SENDER_MODE="per-network"; ACCEPT_PENDING=0; ROTATE_MISSING=0; SHOW_SECRETS=0
SIGNING_POLICY_HINT=""; FSP_SENDER_ADDRESS_HINT=""
ONBOARD_INCOMPLETE=0; UNRESOLVED_NONCES=""; POLICY_ST=ok
while [ "$#" -gt 0 ]; do
  case "$1" in
    --recipient)       RECIP="${2:-}"; shift 2 ;;
    --networks)        NETS="${2:-}"; shift 2 ;;
    --claim-only)      CAPS="claim"; shift ;;
    --sign-only)       CAPS="fsp"; shift ;;
    --skip-fsp-import) SKIP_FSP_IMPORT=1; shift ;;
    --import-existing) IMPORT_EXISTING=1; shift ;;
    --identity)              IDENTITY="${2:-}"; shift 2 ;;
    --signing-policy)        SIGNING_POLICY_HINT="${2:-}"; shift 2 ;;
    --fsp-sender-address)    FSP_SENDER_ADDRESS_HINT="${2:-}"; shift 2 ;;
    --fsp-sender)            FSP_SENDER_MODE="${2:-}"; shift 2 ;;
    --accept-pending-nonces) ACCEPT_PENDING=1; shift ;;
    --rotate-missing-callers) ROTATE_MISSING=1; shift ;;
    --show-secrets)          SHOW_SECRETS=1; shift ;;
    --guided|--explain)      OUTPUT=guided; shift ;;
    -h|--help)         usage ;;
    *)                 die "unknown arg: $1 (try --help)" ;;
  esac
done
case "$FSP_SENDER_MODE" in per-network|shared) : ;; *) die "--fsp-sender must be per-network|shared (got: $FSP_SENDER_MODE)" ;; esac

case ",$CAPS," in *,claim,*) HAS_CLAIM=1 ;; *) HAS_CLAIM=0 ;; esac
case ",$CAPS," in *,fsp,*)   HAS_FSP=1   ;; *) HAS_FSP=0   ;; esac
NFUNC=0
[ "$HAS_CLAIM" -eq 1 ] && NFUNC=$((NFUNC + 1))
[ "$HAS_FSP" -eq 1 ] && NFUNC=$((NFUNC + 1))
[ -d "$FWD_DIR/config" ] || die "no $FWD_DIR/config — set FWD_DIR to the compose bundle"

# Recipient: prompt if claiming and not supplied.
if [ "$HAS_CLAIM" -eq 1 ] && [ -z "$RECIP" ]; then
  if ask_tty "Claim rewards will be paid to this address. Recipient 0x..: " && [ -n "$REPLY" ]; then
    RECIP="$REPLY"
  else
    die "--recipient is required when claiming (or use --sign-only)"
  fi
fi
if [ "$HAS_CLAIM" -eq 1 ]; then
  case "$RECIP" in 0x[0-9a-fA-F]*) : ;; *) die "recipient must be a 0x.. hex address (got: $RECIP)" ;; esac
fi

if [ "$HAS_CLAIM" -eq 1 ] && [ -z "$IDENTITY" ]; then
  if ask_tty "Your reward owner / data-provider identity address 0x..: " && [ -n "$REPLY" ]; then
    IDENTITY="$REPLY"
  else
    die "--identity is required when claiming (or use --sign-only)"
  fi
fi
if [ "$HAS_CLAIM" -eq 1 ]; then
  case "$IDENTITY" in 0x[0-9a-fA-F]*) : ;; *) die "identity must be a 0x.. hex address (got: $IDENTITY)" ;; esac
fi

NETLIST="$(echo "$NETS" | tr ',' ' ')"
for _vn in $NETLIST; do
  case "$_vn" in
    flare|songbird|coston2) ;;
    *) die "invalid network: '$_vn' (must be one of: flare, songbird, coston2)" ;;
  esac
done

# Resolve a network's chain id from the SAME networks.yaml the generator used
# (baked in-container; honors an FWD_NETWORKS_FILE override) — no host-side drift.
chain_of() {
  docker exec "$FWD_CONTAINER" python -c \
    'import os,sys,yaml;p=os.environ.get("FWD_NETWORKS_FILE","/app/config/networks.yaml");print(yaml.safe_load(open(p))[sys.argv[1]]["chain_id"])' \
    "$1"
}

# clif availability — resolved early so the on-chain preflight (Step 2) can use it.
# Graceful degradation: without clif, preflight and nonce reads are skipped.
CLIF_OK=0
if [ -d "${CLIF_SRC:-}" ] && [ -f "$FWD_DIR/docker-compose.clif.yml" ] && [ -x "$FWD_DIR/install/clif" ]; then
  CLIF_OK=1
fi

printf '\033[1;36m=== fwd reward onboarding (%s) ===\033[0m\n' "$CLASS"
guided 'Preparing %s function(s) on %s:\n' "$NFUNC" "$NETS"
[ "$HAS_CLAIM" -eq 1 ] && guided '  • Fee claiming: fwd claims rewards for your identity and sends them to your recipient.\n'
[ "$HAS_FSP" -eq 1 ]   && guided '  • FSP signing: fwd signs uptime/reward messages with your registered signing key.\n'

guided '\n\033[1;36m=== Reward onboarding ===\033[0m\n'
guided 'This command will write the fwd policy, store keys in fwd, create clif caller tokens, seed nonces from chain, and write clif env files.\n'
guided 'clif receives wallet names and caller tokens only. It never receives private keys.\n'
guided 'fwd stays offline and signs only. clif handles chain reads and broadcasts.\n'

# ---- Key preparation narration (--import-existing only) ----
if [ "$IMPORT_EXISTING" -eq 1 ]; then
  _nn=0
  [ "$HAS_FSP" -eq 1 ]   && _nn=$((_nn + 2))
  [ "$HAS_CLAIM" -eq 1 ] && _nn=$((_nn + 1))
  _net_count=0; for _ncc in $NETLIST; do _net_count=$((_net_count + 1)); done
  _total_keys=$((_nn * _net_count))
  printf '\n\033[1;36m─────────────────────────────────────────────────────\033[0m\n'
  printf '\033[1;36m  Keys to prepare — %s private key(s) needed\033[0m\n' "$_total_keys"
  printf '\033[1;36m─────────────────────────────────────────────────────\033[0m\n\n'
  [ -n "$IDENTITY" ] && printf '  Identity : \033[1;96m%s\033[0m\n' "$IDENTITY"
  [ -n "$RECIP" ]    && printf '  Recipient: \033[1;96m%s\033[0m\n' "$RECIP"
  printf '  Network  : %s\n\n' "$NETS"
  printf '  Keys will be sealed into fwd in this order (per network):\n\n'
  _ki=0
  if [ "$HAS_FSP" -eq 1 ]; then
    _ki=$((_ki + 1))
    printf '  \033[1;33m[%s] FSP signing key\033[0m  ← your registered signing policy key\n' "$_ki"
    printf '      Role   : signs uptime/reward messages sent to FlareSystemsManager;\n'
    printf '               ecrecover(message, sig) must equal this on-chain registered address\n'
    if [ -n "$SIGNING_POLICY_HINT" ]; then
      printf '      Address: \033[1;96m%s\033[0m\n' "$SIGNING_POLICY_HINT"
    else
      printf '      Address: your registered signing policy address\n'
      printf '               \033[0;33m→ add --signing-policy 0xADDR to pre-confirm before the prompt\033[0m\n'
    fi
    printf '      Format : 64 hex chars  (secp256k1 private key)\n\n'
    _ki=$((_ki + 1))
    printf '  \033[1;33m[%s] FSP sender key\033[0m\n' "$_ki"
    printf '      Role   : pays gas and submits votes to FlareSystemsManager;\n'
    printf '               msg.sender — not checked by the protocol; any address you\n'
    printf '               control works; use a dedicated low-value gas wallet\n'
    if [ -n "$FSP_SENDER_ADDRESS_HINT" ]; then
      printf '      Address: \033[1;96m%s\033[0m\n' "$FSP_SENDER_ADDRESS_HINT"
    else
      printf '      Address: your choice of gas-paying wallet\n'
      printf '               \033[0;33m→ add --fsp-sender-address 0xADDR to pre-confirm before the prompt\033[0m\n'
    fi
    printf '      Format : 64 hex chars\n\n'
  fi
  if [ "$HAS_CLAIM" -eq 1 ]; then
    _ki=$((_ki + 1))
    printf '  \033[1;33m[%s] Claim executor key\033[0m\n' "$_ki"
    printf '      Role   : calls RewardManager.claim() on your identity'\''s behalf;\n'
    printf '               all rewards are sent to your recipient\n'
    printf '      Address: \033[0;32mshown automatically\033[0m (read from ClaimSetupManager on-chain)\n'
    [ -n "$RECIP" ] && printf '      Recipient: \033[1;96m%s\033[0m\n' "$RECIP"
    printf '      Format : 64 hex chars\n\n'
  fi
  [ "$_net_count" -gt 1 ] && printf '  Each of the %s networks requires its own set of %s key(s) above.\n\n' "$_net_count" "$_nn"
  printf '  Keys are pasted over a hidden stdin pipe into the fwd container,\n'
  printf '  envelope-encrypted immediately, and the plaintext is shredded.\n'
  printf '  Press Enter at any paste prompt to skip that key and import it later.\n\n'
  ask_tty "  Press Enter when your keys are ready to paste ..."
  printf '\n'
fi

# ---- Step 1: fwd health ----
step "Checking fwd" "fwd must be running before onboarding can load policy or store keys."
clifwd health >/dev/null 2>&1 || die "fwd not healthy (is container '$FWD_CONTAINER' up? try: sudo fwd start)"
note "healthy"

# ---- Step 2: on-chain preflight ----
# Reads registered identity (EntityManager) + claim setup state for --identity.
# JSON pass captures signing_policy_address + executor per network for import hints.
# Human-readable pass displays the full picture. Informational — wizard never blocks.
if { [ "$HAS_CLAIM" -eq 1 ] || [ "$HAS_FSP" -eq 1 ]; } && [ "$CLIF_OK" -eq 1 ]; then
  step "On-chain preflight" \
    "Reading registered identity + claim state for $IDENTITY."
  _PF_FAILS=0
  for _pf_net in $NETLIST; do
    # JSON pass: capture signing_policy_address and executor for later import hints.
    if [ -n "$IDENTITY" ]; then
      _pf_j="$(FWD_DIR="$FWD_DIR" FWD_CONTAINER="$FWD_CONTAINER" CLIF_SRC="$CLIF_SRC" \
        "$FWD_DIR/install/clif" preflight --identity "$IDENTITY" --network "$_pf_net" --json \
        2>/dev/null || true)"
      _pf_spa="$(printf '%s' "$_pf_j" | python3 -c \
        'import sys,json; d=json.load(sys.stdin); print(d.get("signing_policy_address",""))' \
        2>/dev/null || true)"
      _pf_exe="$(printf '%s' "$_pf_j" | python3 -c \
        'import sys,json; d=json.load(sys.stdin); a=d.get("executors",[]); print(a[0] if a else "")' \
        2>/dev/null || true)"
      eval "_PREFLIGHT_SPA_${_pf_net}=\"\$_pf_spa\""
      eval "_PREFLIGHT_EXE_${_pf_net}=\"\$_pf_exe\""
    fi
    # Human-readable pass: display full identity picture.
    _pf_args="--identity $IDENTITY"
    [ -n "$RECIP" ] && _pf_args="$_pf_args --recipient $RECIP"
    FWD_DIR="$FWD_DIR" FWD_CONTAINER="$FWD_CONTAINER" CLIF_SRC="$CLIF_SRC" \
      "$FWD_DIR/install/clif" preflight --network "$_pf_net" $_pf_args || _PF_FAILS=$((_PF_FAILS + 1))
  done
  [ "$_PF_FAILS" -gt 0 ] && warn "preflight had RPC errors on $_PF_FAILS network(s) — continuing"
else
  note "no clif layer — skipping on-chain preflight"
fi

# ---- Step 3: build the reward policy ----
step "Building your reward policy" \
  "This policy says exactly what fwd may sign. Claims are locked to your chosen recipient."
TMP="$(mktemp "${TMPDIR:-/tmp}/fwd-onboard-policy.XXXXXX")"
trap 'rm -f "$TMP"' EXIT INT TERM
set +e
if [ "$HAS_CLAIM" -eq 1 ]; then
  clifwd policy init --networks "$NETS" --capabilities "$CAPS" --recipient "$RECIP" --fsp-sender "$FSP_SENDER_MODE" --merge > "$TMP"
else
  clifwd policy init --networks "$NETS" --capabilities "$CAPS" --fsp-sender "$FSP_SENDER_MODE" --merge > "$TMP"
fi
rc=$?
set -e
{ [ "$rc" -eq 0 ] && [ -s "$TMP" ]; } || die "policy init failed (exit $rc) — nothing written, existing policy untouched"

# Write in place (only if changed). A single-file bind mount pins the inode:
# overwrite in place (cat > file keeps the inode) so the container sees the new
# content live; `mv` would NOT be seen until restart.
BAK=""
if [ -f "$POLICY" ] && cmp -s "$TMP" "$POLICY"; then
  CHANGED=0
  note "policy is byte-identical to the current one — no change"
else
  CHANGED=1
  if [ -f "$POLICY" ]; then
    BAK="$POLICY.bak-pre-onboard-$(date +%Y%m%d-%H%M%S)"
    cp "$POLICY" "$BAK"
    note "backed up the existing policy -> $BAK"
  fi
  cat "$TMP" > "$POLICY"
  note "wrote $POLICY"
fi
rm -f "$TMP"; trap - EXIT INT TERM
clifwd policy validate --schema-only >/dev/null || {
  warn "schema validation FAILED — the new policy was NOT loaded."
  [ -n "$BAK" ] && { cat "$BAK" > "$POLICY"; warn "restored prior policy from $BAK"; }
  die "aborting before restart"
}
note "policy validates"

# ---- Step 4: load the policy ----
# ALWAYS (re)load the on-disk policy with `up -d --force-recreate` — never skip, and never a
# plain `restart`. Two traps this avoids: (1) a prior run may have WRITTEN the policy but died
# before loading it, leaving the daemon on the old/inert policy — so we never skip on
# "byte-identical"; (2) a plain `docker compose restart` is NOT a reliable reload — observed
# returning 0 without actually restarting the container, so the daemon kept serving its startup
# (inert) policy and `wallets create` then failed `unknown_policy_path`. force-recreate brings up
# a NEW container that re-reads the bind-mounted policy.yaml, so the load is guaranteed. It is
# idempotent (a few seconds; the sealed master + state volume persist), so onboard self-heals
# from any partial prior run — no manual `rm policy.yaml` or restart ever needed.
step "Loading the policy" "fwd reads policy at startup, so onboarding recreates the container to load the new policy. Wallets and state stay in place."
( cd "$FWD_DIR"
  COMPOSE="-f docker-compose.yml"
  [ -d "${CLIF_SRC:-}" ] && [ -f docker-compose.clif.yml ] && COMPOSE="$COMPOSE -f docker-compose.clif.yml"
  docker compose $COMPOSE up -d --force-recreate fwd >/dev/null ) || die "policy reload (force-recreate) failed (is the stack up? try: sudo fwd start)"
i=0; while [ "$i" -lt 20 ]; do
  st="$(docker inspect -f '{{.State.Health.Status}}' "$FWD_CONTAINER" 2>/dev/null || echo starting)"
  [ "$st" = healthy ] && break
  i=$((i + 1)); sleep 3
done
clifwd health >/dev/null 2>&1 || {
  warn "fwd did not return healthy after the policy reload."
  [ -n "$BAK" ] && warn "restore: cat '$BAK' > '$POLICY' && sudo fwd restart"
  die "health check failed post-reload"
}
note "loaded (fwd recreated, healthy)"; POLICY_ST=ok

# ============================ helpers (provisioning) ============================
wallet_addr() {  # name -> stored address (what fwd derived) or a placeholder
  _a="$(clifwd wallets list 2>/dev/null | awk -v n="$1" '$1==n {print $2}')"
  [ -n "$_a" ] && printf '%s' "$_a" || printf '<not present>'
}
wallet_exists() { clifwd wallets list 2>/dev/null | awk '{print $1}' | grep -qx "$1"; }

wallet_create() {  # name policy role — generate fresh in-vault; echo the derived address + contract role
  role="${3:-wallet}"
  set +e; out="$(clifwd wallets create --name "$1" --policy "$2" 2>&1)"; rc=$?; set -e
  case "$rc" in
    0) note "generated and sealed in fwd: $1 @ $(wallet_addr "$1") — $role" ;;
    3) note "already present: $1 @ $(wallet_addr "$1") — $role" ;;
    *) die "wallets create $1 failed: $out" ;;
  esac
}

# Paste reaches the in-container importer via a 0600 fwd-owned temp + --shred-source;
# never on host disk, never on the network.
import_pasted() {  # name policy role [expected_addr]
  role="${3:-key}"
  _ia_expected="${4:-}"
  if wallet_exists "$1"; then note "already present: $1 @ $(wallet_addr "$1") — $role"; return 0; fi
  if [ "$SKIP_FSP_IMPORT" -eq 1 ]; then
    warn "deferred (--skip-fsp-import) $1 — import later: clifwd wallets import --name $1 --policy $2 --privkey-file <file>"; return 0
  fi
  if [ "$TTY_OK" -ne 1 ]; then
    warn "no terminal to paste $1 — import later: clifwd wallets import --name $1 --policy $2 --privkey-file <file>"; return 0
  fi
  [ -n "$_ia_expected" ] && printf '  \033[0;33m→ expected address: \033[1;96m%s\033[0;33m  (fetch THIS wallet'\''s private key)\033[0m\n' "$_ia_expected"
  _attempt=0
  while [ "$_attempt" -lt 5 ]; do
    _attempt=$((_attempt + 1))
    ask_secret "  paste the private key for $1 — $role (hex, hidden) — or press Enter to skip: "
    if [ -z "$SECRET" ]; then
      warn "skipped $1 — import later: clifwd wallets import --name $1 --policy $2 --privkey-file <file>"; return 0
    fi
    # normalize (strip whitespace + 0x) and validate on the host BEFORE staging:
    # a raw secp256k1 key is exactly 64 hex chars (32 bytes).
    _k="$(printf '%s' "$SECRET" | tr -d ' \t\r\n' | sed 's/^0[xX]//')"; SECRET=''; unset SECRET
    case "$_k" in
      *[!0-9a-fA-F]*) _k=''; warn "that has non-hex characters — paste the RAW hex key (a keystore/base64/mnemonic must be converted to hex first). Try again, or Enter to skip."; continue ;;
    esac
    if [ "${#_k}" -ne 64 ]; then
      warn "expected 64 hex chars (a 32-byte key); got ${#_k}. Try again, or Enter to skip."; _k=''; continue
    fi
    if ! printf '%s' "$_k" | docker exec -i "$FWD_CONTAINER" sh -c 'umask 077; cat > /tmp/.fwd-onboard.key'; then
      _k=''; warn "could not stage the key into the container — try again."; continue
    fi
    _k=''
    if [ -n "$_ia_expected" ]; then
      set +e; out="$(clifwd wallets import --name "$1" --policy "$2" --privkey-file /tmp/.fwd-onboard.key --shred-source --expected-address "$_ia_expected" 2>&1)"; rc=$?; set -e
    else
      set +e; out="$(clifwd wallets import --name "$1" --policy "$2" --privkey-file /tmp/.fwd-onboard.key --shred-source 2>&1)"; rc=$?; set -e
    fi
    docker exec "$FWD_CONTAINER" sh -c 'rm -f /tmp/.fwd-onboard.key' 2>/dev/null || true
    case "$rc" in
      0) note "imported and sealed in fwd: $1 @ $(wallet_addr "$1") — $role (temporary input removed; confirm this address)"; return 0 ;;
      3) note "already present: $1 @ $(wallet_addr "$1") — $role"; return 0 ;;
      *) warn "import failed: $out. Try again, or Enter to skip." ;;
    esac
  done
  warn "gave up on $1 after $_attempt attempts — import later: clifwd wallets import --name $1 --policy $2 --privkey-file <file>"
}

caller_create() {  # name policy
  set +e; key="$(clifwd callers create --name "$1" --policy "$2" 2>/dev/null)"; rc=$?; set -e
  case "$rc" in
    0) printf '   \033[1;32mTOKEN (shown ONCE)\033[0m %-18s -> clif API key for this caller\n     %s\n' "$1" "$key" ;;
    3) warn "caller exists (skip): $1 — token was shown once and can't be re-displayed; revoke+recreate if lost: clifwd callers revoke --name $1" ;;
    *) die "callers create $1 failed (exit $rc)" ;;
  esac
  unset key
}

nonce_seed() {  # name chain starting_nonce
  set +e; out="$(clifwd nonce init --wallet "$1" --chain "$2" --starting-nonce "$3" 2>&1)"; rc=$?; set -e
  if [ "$rc" -eq 0 ]; then note "nonce seeded: $1 @ chain $2 = $3"
  elif printf '%s' "$out" | grep -q nonce_already_initialized; then note "nonce exists (skip): $1 @ chain $2"
  else die "nonce init $1/$2 failed: $out"
  fi
}
ask_nonce() {  # name -> echoes the starting nonce to stdout
  if [ "$IMPORT_EXISTING" -eq 1 ] && [ "$TTY_OK" -eq 1 ]; then
    printf '   %s sends transactions, so fwd needs its next nonce (fwd is offline; it cannot read the chain).\n' "$1" >/dev/tty
    ask_tty "   nonce for $1 = its current on-chain transaction count (look up $(wallet_addr "$1") on the block explorer; enter 0 if this key has never sent a tx) [default 0]: "
    if [ -z "$REPLY" ]; then warn "no nonce given for $1 — using 0 (fix later via clifwd nonce-sync if the key has already sent txs)"; printf '0'
    else printf '%s' "$REPLY"; fi
  else
    printf '0'
  fi
}
seed_sender() {  # name chain — seed nonce if the wallet exists, else a deferred note
  if wallet_exists "$1"; then nonce_seed "$1" "$2" "$(ask_nonce "$1")"
  else warn "$1 not present (import deferred) — after importing: clifwd nonce init --wallet $1 --chain $2 --starting-nonce <n>"; fi
}

# Without a clif layer there is no env to write tokens to — show them so they're not lost.
[ "$CLIF_OK" -eq 0 ] && [ "$SHOW_SECRETS" -eq 0 ] && { SHOW_SECRETS=1; warn "no clif layer present — caller tokens will be printed (no env to write them to)"; }

sender_name() {  # net -> the FSP gas-payer wallet name
  if [ "$FSP_SENDER_MODE" = per-network ]; then printf 'fsp-sender-%s' "$1"; else printf 'fsp-sender'; fi
}
sender_wc() {    # net -> the FSP gas-payer wallet_constraints policy_path
  if [ "$FSP_SENDER_MODE" = per-network ]; then printf 'wc/fsp-sender-%s' "$1"; else printf 'wc/fsp-sender'; fi
}

# read chain truth via the keyless clif one-shot (egress); echoes "latest pending chain_id"
read_chain_nonce() {  # net addr
  [ "$CLIF_OK" -eq 1 ] || return 1
  _rcn_j="$(FWD_DIR="$FWD_DIR" FWD_CONTAINER="$FWD_CONTAINER" CLIF_SRC="$CLIF_SRC" \
            "$FWD_DIR/install/clif" chain nonce --network "$1" --address "$2" --json 2>/dev/null)" || return 1
  [ -n "$_rcn_j" ] || return 1
  printf '%s' "$_rcn_j" | docker exec -i "$FWD_CONTAINER" python -c \
    'import sys,json; d=json.load(sys.stdin); print(d["latest"], d["pending"], d["chain_id"])' 2>/dev/null
}

# echo fwd's current next_nonce for (name, chain); return 4 if no row, 1 on error
fwd_nonce_get() {  # name chain
  set +e; _fng_o="$(clifwd nonce get --wallet "$1" --chain "$2" --json 2>/dev/null)"; _fng_rc=$?; set -e
  [ "$_fng_rc" -eq 4 ] && return 4
  [ "$_fng_rc" -ne 0 ] && return 1
  printf '%s' "$_fng_o" | docker exec -i "$FWD_CONTAINER" python -c \
    'import sys,json; print(json.load(sys.stdin)["next_nonce"])' 2>/dev/null
}

nonce_init_exact()  { clifwd nonce init         --wallet "$1" --chain "$2" --starting-nonce "$3" >/dev/null 2>&1 || die "nonce init $1/$2=$3 failed"; }
nonce_init_force()  { clifwd nonce init --force --wallet "$1" --chain "$2" --starting-nonce "$3" >/dev/null 2>&1 || die "nonce init --force $1/$2=$3 failed"; }
nonce_try_sync()    { set +e; clifwd nonce sync --wallet "$1" --chain "$2" --on-chain-count "$3" >/dev/null 2>&1; _nts_rc=$?; set -e; return "$_nts_rc"; }

confirm() {  # prompt -> 0 if yes (default no; non-tty = no)
  [ "$TTY_OK" -eq 1 ] || return 1
  ask_tty "$1 [y/N]: " || return 1
  case "$REPLY" in y|Y|yes|YES) return 0 ;; *) return 1 ;; esac
}

cutover_msg() {  # name addr net latest pending
  warn "Pending txs exist for $1 ($2) on $3:"
  warn "  latest=$4 pending=$5"
  warn "Do not cut over while another submitter or in-flight tx owns this account."
  warn "Stop the old submitter, wait for pending txs to mine/drop, then rerun."
  warn "To intentionally seed to pending, rerun with --accept-pending-nonces."
}

# the no-hand-typing nonce state machine (chain truth -> fwd row reconciliation)
reconcile_nonce() {  # name chain net addr
  _rn_name="$1"; _rn_chain="$2"; _rn_net="$3"; _rn_addr="$4"
  if _rn_vals="$(read_chain_nonce "$_rn_net" "$_rn_addr")" && [ -n "$_rn_vals" ]; then
    # shellcheck disable=SC2086
    set -- $_rn_vals; _rn_latest="$1"; _rn_pending="$2"; _rn_cid="$3"
    [ "$_rn_cid" = "$_rn_chain" ] || die "clif chain_id ($_rn_cid) != fwd chain ($_rn_chain) for $_rn_net"
    if [ "$_rn_pending" -eq "$_rn_latest" ]; then _rn_target="$_rn_latest"
    elif [ "$_rn_pending" -gt "$_rn_latest" ]; then
      if [ "$ACCEPT_PENDING" -eq 1 ]; then _rn_target="$_rn_pending"
      else cutover_msg "$_rn_name" "$_rn_addr" "$_rn_net" "$_rn_latest" "$_rn_pending"; die "cutover blocked for $_rn_name (pending > latest)"; fi
    else _rn_target="$_rn_latest"; fi
  else
    warn "couldn't read chain nonce for $_rn_name ($_rn_addr) via clif — falling back to manual entry (the value you enter is reconciled against fwd's row, same as chain truth)"
    _rn_target="$(ask_nonce "$_rn_name")"
    case "$_rn_target" in ''|*[!0-9]*) die "manual nonce for $_rn_name must be a non-negative integer (got: '$_rn_target')" ;; esac
  fi
  set +e; _rn_cur="$(fwd_nonce_get "$_rn_name" "$_rn_chain")"; _rn_grc=$?; set -e
  if [ "$_rn_grc" -eq 4 ]; then
    nonce_init_exact "$_rn_name" "$_rn_chain" "$_rn_target"; note "nonce seeded: $_rn_name @ chain $_rn_chain = $_rn_target (chain truth)"; return 0
  fi
  [ "$_rn_grc" -eq 0 ] || die "could not read fwd nonce for $_rn_name/$_rn_chain"
  if [ "$_rn_cur" -eq "$_rn_target" ]; then note "nonce in sync: $_rn_name @ chain $_rn_chain = $_rn_cur"; return 0; fi
  if [ "$_rn_cur" -lt "$_rn_target" ]; then
    set +e; nonce_try_sync "$_rn_name" "$_rn_chain" "$_rn_target"; _rn_src=$?; set -e
    if [ "$_rn_src" -eq 0 ]; then note "nonce advanced: $_rn_name $_rn_cur -> $_rn_target"; return 0; fi
    if [ "$_rn_src" -eq 5 ]; then
      if [ "$ACCEPT_PENDING" -eq 1 ] || confirm "chain is far ahead for $_rn_name ($_rn_cur -> $_rn_target); force fwd nonce to $_rn_target?"; then
        nonce_init_force "$_rn_name" "$_rn_chain" "$_rn_target"; note "nonce force-advanced: $_rn_name -> $_rn_target"; return 0
      fi
      die "refusing large nonce jump for $_rn_name; re-run with --accept-pending-nonces"
    fi
    die "nonce sync failed for $_rn_name (rc=$_rn_src)"
  fi
  # cur > target: fwd ahead of chain — never silently rewind
  if confirm "fwd nonce for $_rn_name ($_rn_cur) is AHEAD of chain ($_rn_target); rewind? (safe only if no fwd-signed tx is in flight)"; then
    nonce_init_force "$_rn_name" "$_rn_chain" "$_rn_target"; note "nonce rewound: $_rn_name $_rn_cur -> $_rn_target (forced)"; return 0
  fi
  ONBOARD_INCOMPLETE=1
  UNRESOLVED_NONCES="$UNRESOLVED_NONCES $_rn_name@$_rn_net(chain=$_rn_chain:fwd=$_rn_cur>chain_truth=$_rn_target)"
  warn "left $_rn_name at $_rn_cur (no rewind) — resolve before using this wallet"
}

# read KEY=value from an env file (first match), else default
getval() {  # file key default
  if [ -f "$1" ]; then
    _gv="$(sed -n "s/^$2=//p" "$1" | head -n1)"
    [ -n "$_gv" ] && { printf '%s' "$_gv"; return 0; }
  fi
  printf '%s' "$3"
}

token_ok() {  # token -> 0 iff a well-formed fwd live token (safe to eval-assign)
  printf '%s' "$1" | grep -qE '^fwd_live_[A-Za-z0-9_-]{43}$'
}

# mint or recover a caller token; sets the named outvar to the FINAL token to write
caller_ensure() {  # name policy outvar envfile envkey
  set +e; _ce_k="$(clifwd callers create --name "$1" --policy "$2" 2>/dev/null)"; _ce_rc=$?; set -e
  case "$_ce_rc" in
    0) token_ok "$_ce_k" || die "minted token for $1 has unexpected format (not fwd_live_<43>) — aborting before eval"
       eval "$3=\$_ce_k"
       if [ "$SHOW_SECRETS" -eq 1 ]; then note "caller $1: token = $_ce_k"
       else note "caller $1: token minted -> clif env (prefix $(printf '%s' "$_ce_k" | cut -c1-12)…)"; fi ;;
    3) _ce_have="$(getval "$4" "$5" "")"
       if [ -n "$_ce_have" ]; then
         token_ok "$_ce_have" || die "token for $1 in $(basename "$4") is malformed/tampered (not fwd_live_<43>) — refusing to use it; fix or remove that line"
         eval "$3=\$_ce_have"; note "caller $1 exists; preserving the token already in $(basename "$4")"
       elif [ "$ROTATE_MISSING" -eq 1 ]; then
         note "caller $1 exists but its one-time token is lost and $(basename "$4") has none — rotating"
         clifwd callers revoke --name "$1" >/dev/null 2>&1 || die "revoke $1 failed"
         set +e; _ce_k="$(clifwd callers create --name "$1" --policy "$2" --replace 2>/dev/null)"; _ce_rc=$?; set -e
         [ "$_ce_rc" -eq 0 ] || die "re-mint $1 failed (exit $_ce_rc)"
         token_ok "$_ce_k" || die "re-minted token for $1 has unexpected format — aborting before eval"
         eval "$3=\$_ce_k"; note "caller $1 re-minted -> clif env"
       else
         die "caller $1 exists but its one-time token is lost and $(basename "$4") has no token; re-run with --rotate-missing-callers to revoke+re-mint, or restore the token to $(basename "$4")"
       fi ;;
    *) die "callers create $1 failed (exit $_ce_rc)" ;;
  esac
  unset _ce_k
}

# atomically write clif's per-network env (0600; keyless)
env_write() {  # net claim_tok sign_tok submit_tok
  _ew_net="$1"; _ew_ct="$2"; _ew_st="$3"; _ew_sub="$4"
  _ew_dst="$CLIF_SRC/.env.$_ew_net"
  _ew_tmp="$(mktemp "$CLIF_SRC/.env.$_ew_net.XXXXXX")" || die "mktemp failed in $CLIF_SRC"
  {
    printf 'NETWORK=%s\n' "$_ew_net"
    printf 'FWD_ENDPOINT=%s\n' "$(getval "$_ew_dst" FWD_ENDPOINT http://fwd:8080)"
    if [ "$HAS_CLAIM" -eq 1 ]; then
      printf 'IDENTITY_ADDRESS=%s\n' "$(getval "$_ew_dst" IDENTITY_ADDRESS "$IDENTITY")"
      printf 'CLAIM_RECIPIENT_ADDRESS=%s\n' "$(getval "$_ew_dst" CLAIM_RECIPIENT_ADDRESS "$RECIP")"
      printf 'FWD_WALLET_NAME=%s\n' "claimer-$_ew_net"
      printf 'FWD_CALLER_TOKEN=%s\n' "$_ew_ct"
    fi
    printf 'WRAP_REWARDS=%s\n' "$(getval "$_ew_dst" WRAP_REWARDS false)"
    if [ "$HAS_FSP" -eq 1 ]; then
      printf 'FSP_SIGN_CALLER_TOKEN=%s\n' "$_ew_st"
      printf 'FSP_SUBMIT_CALLER_TOKEN=%s\n' "$_ew_sub"
      printf 'FSP_SIGNING_WALLET_NAME=%s\n' "fsp-signing-$_ew_net"
      printf 'FSP_SENDER_WALLET_NAME=%s\n' "$(sender_name "$_ew_net")"
    fi
    printf 'CLIF_STATE_DIR=.clif-state/%s\n' "$_ew_net"
    printf 'FSP_AUTO_ENABLED=%s\n' "$(getval "$_ew_dst" FSP_AUTO_ENABLED false)"
    for _ew_rv in FLARE_RPC SONGBIRD_RPC COSTON2_RPC; do
      _ew_ov="$(getval "$_ew_dst" "$_ew_rv" "")"; [ -n "$_ew_ov" ] && printf '%s=%s\n' "$_ew_rv" "$_ew_ov"
    done
  } > "$_ew_tmp"
  if grep -qi 'PRIVATE_KEY' "$_ew_tmp"; then rm -f "$_ew_tmp"; die "refusing to write $_ew_dst — it contains a *PRIVATE_KEY* name"; fi
  chmod 0600 "$_ew_tmp"; mv -f "$_ew_tmp" "$_ew_dst"
  note "clif env written: $_ew_dst (0600, keyless)"
}

# ====================== Function: FSP REWARD SIGNING ======================
if [ "$HAS_FSP" -eq 1 ]; then
  fsection "FSP REWARD SIGNING" "fwd will use your registered FSP signing key to sign uptime and reward messages. A sender wallet pays gas and submits them."
  for net in $NETLIST; do
    cid="$(chain_of "$net")" || die "could not resolve chain id for '$net'"
    _sender="$(sender_name "$net")"
    # Signing key: always imported (registered protocol key — never generated fresh)
    _expected_sp="${SIGNING_POLICY_HINT:-}"
    if [ -z "$_expected_sp" ]; then
      eval "_expected_sp=\"\${_PREFLIGHT_SPA_${net}:-}\""
    fi
    if [ -z "$_expected_sp" ]; then
      _pf_env="$CLIF_SRC/.env.$net"
      [ -f "$_pf_env" ] && _expected_sp="$(grep -E '^SIGNING_POLICY_ADDRESS=' \
        "$_pf_env" 2>/dev/null | cut -d= -f2- || true)"
    fi
    import_pasted "fsp-signing-$net" "wc/fsp-$net" \
      "your registered FSP signing key; Flare checks this signature" \
      "$_expected_sp"
    # Sender: import (migration) or generate fresh
    if [ "$IMPORT_EXISTING" -eq 1 ]; then
      import_pasted "$_sender" "$(sender_wc "$net")" \
        "the wallet that pays gas and submits FSP messages" \
        "${FSP_SENDER_ADDRESS_HINT:-}"
    else
      wallet_create "$_sender" "$(sender_wc "$net")" "the wallet that pays gas and submits FSP messages"
    fi
    caller_ensure "fsp-sign-$net"   "fsp/$net"             _t_sign "$CLIF_SRC/.env.$net" FSP_SIGN_CALLER_TOKEN
    caller_ensure "fsp-submit-$net" "perm/fsp-submit-$net" _t_sub  "$CLIF_SRC/.env.$net" FSP_SUBMIT_CALLER_TOKEN
    eval "TOK_FSPSIGN_$net=\$_t_sign"; eval "TOK_FSPSUBMIT_$net=\$_t_sub"
    if wallet_exists "$_sender"; then reconcile_nonce "$_sender" "$cid" "$net" "$(wallet_addr "$_sender")"
    else warn "$_sender not present (import deferred) — seed its nonce after importing: clifwd nonce init --wallet $_sender --chain $cid --starting-nonce <n>"; fi
  done
fi

# ====================== Function: FEE CLAIMING ======================
if [ "$HAS_CLAIM" -eq 1 ]; then
  fsection "FEE CLAIMING" "fwd will use one wallet to call RewardManager.claim for your identity. Any claim made by this wallet must pay your chosen recipient."
  for net in $NETLIST; do
    cid="$(chain_of "$net")" || die "could not resolve chain id for '$net'"
    if [ "$IMPORT_EXISTING" -eq 1 ]; then
      _expected_claimer=""
      eval "_expected_claimer=\"\${_PREFLIGHT_EXE_${net}:-}\""
      if [ -z "$_expected_claimer" ] && [ "$CLIF_OK" -eq 1 ] && [ -n "$IDENTITY" ]; then
        _pf_j="$(FWD_DIR="$FWD_DIR" FWD_CONTAINER="$FWD_CONTAINER" CLIF_SRC="$CLIF_SRC" \
          "$FWD_DIR/install/clif" preflight --identity "$IDENTITY" --network "$net" --json 2>/dev/null || true)"
        _expected_claimer="$(printf '%s' "$_pf_j" | python3 -c \
          'import sys,json; d=json.load(sys.stdin); a=d.get("executors",[]); print(a[0] if a else "")' \
          2>/dev/null || true)"
      fi
      import_pasted "claimer-$net" "wc/claimer-$net" \
        "the wallet that claims rewards for your identity and pays your recipient" \
        "$_expected_claimer"
    else
      wallet_create "claimer-$net" "wc/claimer-$net" "the wallet that claims rewards for your identity and pays your recipient"
    fi
    caller_ensure "claim-$net" "perm/claim-$net" _t_claim "$CLIF_SRC/.env.$net" FWD_CALLER_TOKEN
    eval "TOK_CLAIM_$net=\$_t_claim"
    if wallet_exists "claimer-$net"; then reconcile_nonce "claimer-$net" "$cid" "$net" "$(wallet_addr "claimer-$net")"
    else warn "claimer-$net not present (import deferred) — seed its nonce after importing: clifwd nonce init --wallet claimer-$net --chain $cid --starting-nonce <n>"; fi
  done
fi

# ====================== clif runtime config (.env.<net>) ======================
if [ "$CLIF_OK" -eq 1 ]; then
  printf '\n\033[1;35m═══════════════ clif runtime config ═══════════════\033[0m\n'
  printf '   Writing per-network clif env files. They contain wallet names and caller tokens only; no private keys. Mode 0600.\n'
  for net in $NETLIST; do
    eval "_w_ct=\${TOK_CLAIM_$net:-}"; eval "_w_st=\${TOK_FSPSIGN_$net:-}"; eval "_w_sub=\${TOK_FSPSUBMIT_$net:-}"
    env_write "$net" "$_w_ct" "$_w_st" "$_w_sub"
  done
else
  warn "no clif layer present — skipped writing clif .env files (install with --with-clif to enable)"
fi

# ---- summary cockpit (both modes — the operator's current-state view) ----
printf '\n\033[1monboarding summary\033[0m\n'
printf '%-10s %-7s %-8s %-8s %-7s %s\n' network policy wallets callers nonce 'clif env'
for net in $NETLIST; do
  _sm_w=ok
  if [ "$HAS_CLAIM" -eq 1 ]; then wallet_exists "claimer-$net" || _sm_w=defer; fi
  if [ "$HAS_FSP" -eq 1 ]; then
    wallet_exists "$(sender_name "$net")" || _sm_w=defer
    wallet_exists "fsp-signing-$net" || _sm_w=defer
  fi
  case " $UNRESOLVED_NONCES " in
    *"@$net("*) _sm_n=drift ;;
    *) if [ "$_sm_w" = ok ]; then _sm_n=ok; else _sm_n=defer; fi ;;
  esac
  if [ "$CLIF_OK" -eq 1 ]; then _sm_ce=written; else _sm_ce='-'; fi
  printf '%-10s %-7s %-8s %-8s %-7s %s\n' "$net" "$POLICY_ST" "$_sm_w" ok "$_sm_n" "$_sm_ce"
done

# ====================== Final — on-chain (operator-only, offline identity key) ======================
printf '\n\033[1;36m── Final — on-chain authorization (you, offline)\033[0m\n'
guided '   Use your offline identity key for the on-chain step. fwd never has that key.\n'
guided '\n=============================================================================\n'
if [ "$IMPORT_EXISTING" -eq 1 ]; then
  printf '\033[1;31mCUTOVER\033[0m — your imported keys are already live on-chain. Before using fwd:\n'
  for net in $NETLIST; do
    printf '  [%s]\n' "$net"
    [ "$HAS_CLAIM" -eq 1 ] && printf '    stop old claiming software for claimer-%s (%s)\n' "$net" "$(wallet_addr "claimer-$net")"
    if [ "$HAS_FSP" -eq 1 ]; then
      printf '    stop old FSP software that uses %s (%s)\n' "$(sender_name "$net")" "$(wallet_addr "$(sender_name "$net")")"
      printf '    stop old FSP software that uses fsp-signing-%s (%s)\n' "$net" "$(wallet_addr "fsp-signing-$net")"
    fi
    [ "$HAS_CLAIM" -eq 1 ] && printf '    verify %s is still an allowed claim recipient\n' "$RECIP"
  done
  printf 'If any imported key is NOT already authorized/registered on-chain, run the greenfield steps:\n'
  printf '  ClaimSetupManager.setClaimExecutors · setAllowedClaimRecipients · register the FSP signer as your voter address.\n'
  printf 'If old claiming/submitting software keeps sending from the claimer or sender accounts,\n'
  printf 'it can collide with fwd on nonces. Stop it first.\n'
else
  printf '\033[1;31mon-chain authorization required\033[0m — use your offline identity key; fwd never has it:\n'
  for net in $NETLIST; do
    printf '  [%s]\n' "$net"
    if [ "$HAS_CLAIM" -eq 1 ]; then
      printf '    authorize claim executor: %s (%s)\n' "claimer-$net" "$(wallet_addr "claimer-$net")"
      printf '      method: ClaimSetupManager.setClaimExecutors\n'
      printf '    allow recipient: %s\n' "$RECIP"
      printf '      method: setAllowedClaimRecipients\n'
    fi
    if [ "$HAS_FSP" -eq 1 ]; then
      printf '    register FSP signer: %s (%s)\n' "fsp-signing-$net" "$(wallet_addr "fsp-signing-$net")"
      printf '      use it as your signing policy / voter address\n'
    fi
    [ "$HAS_CLAIM" -eq 1 ] && printf '    fund gas wallet: claimer-%s (%s) — pays tx gas\n' "$net" "$(wallet_addr "claimer-$net")"
    [ "$HAS_FSP" -eq 1 ]   && printf '    fund gas wallet: %s (%s) — pays tx gas\n' "$(sender_name "$net")" "$(wallet_addr "$(sender_name "$net")")"
  done
fi
printf '\nRehearse with the host `clif` wrapper. Do not use raw `docker compose run`; it reads the placeholder env file:\n'
for net in $NETLIST; do
  [ "$HAS_CLAIM" -eq 1 ] && printf '  clif --network %s claim --type fee\n' "$net"
  [ "$HAS_FSP" -eq 1 ]   && printf '  clif --network %s fsp uptime --epoch <N>   (and: clif --network %s fsp rewards --epoch <N>)\n' "$net" "$net"
done
printf '  clifwd audit verify\n'
printf "Before Flare, use Songbird as the canary: verify the RewardClaimed event on-chain and run 'clifwd audit verify'.\n"
guided 'Full detail: docs/one-command-install.md\n'
guided '=============================================================================\n'
if [ "$ONBOARD_INCOMPLETE" -eq 1 ]; then
  printf '\n\033[1;31m⚠ onboard finished WITH UNRESOLVED NONCE DRIFT\033[0m — fwd nonce is AHEAD of chain for:%s\n' "$UNRESOLVED_NONCES"
  printf '   Those wallets were left as-is (no rewind). Resolve before use — investigate in-flight txs; rewind via `clifwd nonce init --force` ONLY if safe. This is NOT a completed onboard.\n'
  exit 1
else
  printf '\n\033[1;32m✓ onboard complete\033[0m — policy loaded; wallets/callers/nonces ready. The on-chain step above is yours.\n'
fi
