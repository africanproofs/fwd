    printf '  [%s]\n' "$net"
    [ "$HAS_CLAIM" -eq 1 ] && printf '    Fee claiming:  STOP the old claimer for claimer-%s (%s) — fwd is now its sole user\n' "$net" "$(wallet_addr "claimer-$net")"
    if [ "$HAS_FSP" -eq 1 ]; then
      printf '    FSP signing:   STOP the old submitter for %s (%s)\n' "$(sender_name "$net")" "$(wallet_addr "$(sender_name "$net")")"
      printf '                   and fsp-signing-%s (%s) — sole-submitter cutover\n' "$net" "$(wallet_addr "fsp-signing-$net")"
    fi
