#!/bin/sh
# Host `fwd` lifecycle wrapper — Compose is an implementation detail of these.
# Installed to /usr/local/bin/fwd by install.sh.
#
# Operates from $FWD_DIR (default /opt/fwd), which holds the compose bundle +
# fetched source. fwd is the ZERO-EGRESS SIGNER ONLY: this wrapper manages fwd +
# litestream and nothing else. The clif consumer (reward claiming + FSP signing) is
# a SEPARATE deployment with its own compose project + egress — manage it with clif's
# own `clifctl`. fwd never launches clif.
#
#   sudo fwd start | stop | restart | status | logs | onboard
#
# `fwd start` brings up fwd (+ litestream). To run the automation, deploy clif
# separately and `clifctl up <net>`.
#
# `upgrade` and `backup` are finalized with install.sh in Phase 1 (they need the
# release-manifest fetch + docs/restore-runbook.md); stubbed here so the
# command contract is visible and honest.
set -eu

FWD_DIR="${FWD_DIR:-/opt/fwd}"
cd "$FWD_DIR"

COMPOSE="-f docker-compose.yml"
# Pin the compose project to the container name so this wrapper operates the SAME project the
# installer created — immune to a stale COMPOSE_PROJECT_NAME in the operator's shell.
export COMPOSE_PROJECT_NAME="${FWD_CONTAINER:-fwd}"

cmd="${1:-}"
[ "$#" -gt 0 ] && shift

case "$cmd" in
  start)
    # fwd start = fwd + litestream only. A <net>/fsp arg is rejected: the epoch sign→claim
    # automation is now a SEPARATE clif deployment (clifctl up <net>), not bundled into fwd.
    case "${1:-}" in
      flare|songbird|coston2|fsp)
        echo "fwd start no longer launches clif — the automation is a SEPARATE deployment." >&2
        echo "Deploy clif and run its lifecycle tool:  clifctl up ${1}" >&2
        echo "(fwd is the zero-egress signer; 'fwd start' brings up fwd + litestream only.)" >&2
        exit 2 ;;
    esac
    set +e; docker compose $COMPOSE up -d "$@"; _rc=$?; set -e
    [ "$_rc" -eq 0 ] && printf 'requested (docker compose up -d):\n  fwd\n  litestream\n'
    exit "$_rc"
    ;;
  stop)    exec docker compose $COMPOSE stop "$@" ;;
  restart) exec docker compose $COMPOSE restart "$@" ;;
  status)
    # fwd-only cockpit: real compose state + the next action. Exits with `docker compose ps`'s
    # status so a monitor/script sees a Docker/daemon failure.
    printf 'fwd daemon (zero-egress signer):\n'
    set +e; docker compose $COMPOSE ps "$@"; _rc=$?; set -e
    printf '\nnext: sudo fwd onboard rewards …  then deploy clif separately and: clifctl up <net>\n'
    [ "$_rc" -ne 0 ] && printf 'fwd status: docker compose ps exited %s\n' "$_rc" >&2
    exit "$_rc"
    ;;
  logs)    exec docker compose $COMPOSE logs "$@" ;;
  onboard) exec env FWD_DIR="$FWD_DIR" FWD_CONTAINER="${FWD_CONTAINER:-fwd}" "$FWD_DIR/install/onboard" "$@" ;;
  upgrade|backup)
    echo "fwd $cmd: finalized with install.sh in Phase 1 — see docs/one-command-install.md" >&2
    exit 2
    ;;
  ""|help|-h|--help)
    echo "usage: fwd {start|stop|restart|status|logs|onboard} [args...]" >&2
    echo "       fwd start  → fwd + litestream (the zero-egress signer; never launches clif)" >&2
    echo "       reward onboarding: fwd onboard rewards --identity 0x.. --recipient 0x.. --networks songbird" >&2
    echo "       (provisions fwd custody + publishes the handoff bundle to fwd's outbox; --guided for the walk-through)" >&2
    echo "       automation: deploy clif separately, then clifctl up <net>  (NOT 'fwd start <net>')" >&2
    echo "       (upgrade|backup: Phase 1 — see docs/one-command-install.md)" >&2
    [ "$cmd" = "" ] && exit 2 || exit 0
    ;;
  *)
    echo "fwd: unknown command '$cmd' (try: fwd help)" >&2
    exit 2
    ;;
esac
