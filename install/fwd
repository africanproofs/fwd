#!/bin/sh
# Host `fwd` lifecycle wrapper — Compose is an implementation detail of these.
# Installed to /usr/local/bin/fwd by install.sh.
#
# Operates from $FWD_DIR (default /opt/fwd), which holds the compose bundle +
# fetched source. The `--with-clif` overlay is included automatically when
# docker-compose.clif.yml is present + clif is installed ($CLIF_SRC exists).
#
#   sudo fwd start [<net>] | stop | restart | status | logs
#
# `fwd start` brings up fwd (+ litestream) only; `fwd start <net>` (flare|songbird|coston2)
# starts that network's clif CLAIM daemon; `fwd start <net> fsp` starts its FSP auto-signer
# ONLY (opt-in; requires FSP_AUTO_ENABLED=true). Claim+FSP provider = run both commands.
#
# `upgrade` and `backup` are finalized with install.sh in Phase 1 (they need the
# release-manifest fetch + the documented restore runbook); stubbed here so the
# command contract is visible and honest.
set -eu

FWD_DIR="${FWD_DIR:-/opt/fwd}"
CLIF_SRC="${CLIF_SRC:-/opt/fwd/clif}"
cd "$FWD_DIR"

COMPOSE="-f docker-compose.yml"
[ -d "$CLIF_SRC" ] && [ -f docker-compose.clif.yml ] && COMPOSE="$COMPOSE -f docker-compose.clif.yml"
# clif build context + env live at the install root; export so the overlay
# resolves them (the wrappers run compose from the bundle dir, not the root).
export CLIF_SRC CLIF_ENV="${CLIF_ENV:-$CLIF_SRC/.env}"

cmd="${1:-}"
[ "$#" -gt 0 ] && shift

case "$cmd" in
  start)
    # `fwd start` = fwd (+ litestream) only. `fwd start <net>` starts that network's CLAIM
    # daemon ONLY (--profile <net>); `fwd start <net> fsp` starts its FSP auto-signer ONLY
    # (--profile <net>-fsp; opt-in, meaningful only with FSP_AUTO_ENABLED=true). A claim+FSP
    # provider runs BOTH commands; keeping them independent stops a sign-only (no-claim) setup
    # from launching a beneficiary-less claim daemon (which clif `auto` exits on → restart-loop).
    # Profiles are a59-exact; this case adds only a compact requested/not-requested cockpit (so
    # it no longer `exec`s — it runs `up -d`, reports what it ASKED to bring up, then exits with
    # compose's status). `up -d` returning 0 does NOT prove a daemon stayed up — `fwd status` does.
    case "$COMPOSE" in *docker-compose.clif.yml*) _has_clif=1 ;; *) _has_clif=0 ;; esac
    case "${1:-}" in
      flare|songbird|coston2)
        _net="$1"; shift
        if [ "${1:-}" = fsp ]; then
          shift; _prof="$_net-fsp"; _svc="clif-fsp-auto-$_net"; _other="clif-auto-$_net"; _ohint="sudo fwd start $_net"
        else
          _prof="$_net"; _svc="clif-auto-$_net"; _other="clif-fsp-auto-$_net"; _ohint="sudo fwd start $_net fsp"
        fi
        set +e; docker compose $COMPOSE --profile "$_prof" up -d "$@"; _rc=$?; set -e
        if [ "$_rc" -eq 0 ]; then
          printf 'requested (docker compose up -d):\n  fwd\n  litestream\n'
          if [ "$_has_clif" -eq 1 ]; then
            printf '  %s\nnot requested:\n  %s  (use: %s)\n' "$_svc" "$_other" "$_ohint"
            printf 'confirm it stayed up (up -d does not guarantee it): sudo fwd status  |  sudo fwd logs %s\n' "$_svc"
          else
            printf '(clif not installed — fwd + litestream only)\n'
          fi
        fi
        exit "$_rc"
        ;;
      fsp) echo "fwd start: 'fsp' needs a network — e.g. 'fwd start songbird fsp'" >&2; exit 2 ;;
      *)
        set +e; docker compose $COMPOSE up -d "$@"; _rc=$?; set -e
        [ "$_rc" -eq 0 ] && printf 'requested (docker compose up -d):\n  fwd\n  litestream\n'
        exit "$_rc"
        ;;
    esac
    ;;
  stop)    exec docker compose $COMPOSE stop "$@" ;;
  restart) exec docker compose $COMPOSE restart "$@" ;;
  status)
    # bounded cockpit: real compose state + clif env presence per network + next action.
    # Exits with `docker compose ps`'s status so a monitor/script sees a Docker/daemon failure.
    printf 'fwd daemon:\n'
    set +e; docker compose $COMPOSE ps "$@"; _rc=$?; set -e
    if [ -d "$CLIF_SRC" ]; then
      printf '\nclif env files (%s):\n' "$CLIF_SRC"
      _any=0
      for _n in flare songbird coston2; do
        if [ -f "$CLIF_SRC/.env.$_n" ]; then printf '  %-9s present\n' "$_n"; _any=1; fi
      done
      if [ "$_any" -eq 0 ]; then printf '  (none yet — run: sudo fwd onboard rewards …)\n'; fi
    fi
    printf '\nnext: sudo fwd start <net>  (claim daemon)  |  sudo fwd start <net> fsp  (FSP daemon)\n'
    [ "$_rc" -ne 0 ] && printf 'fwd status: docker compose ps exited %s\n' "$_rc" >&2
    exit "$_rc"
    ;;
  logs)    exec docker compose $COMPOSE logs "$@" ;;
  onboard) exec env FWD_DIR="$FWD_DIR" FWD_CONTAINER="${FWD_CONTAINER:-fwd}" CLIF_SRC="$CLIF_SRC" CLIF_ENV="$CLIF_ENV" "$FWD_DIR/install/onboard" "$@" ;;
  upgrade|backup)
    echo "fwd $cmd: finalized with install.sh in Phase 1 — see docs/one-command-install.md" >&2
    exit 2
    ;;
  ""|help|-h|--help)
    echo "usage: fwd {start [<net> [fsp]]|stop|restart|status|logs|onboard} [args...]" >&2
    echo "       fwd start  (fwd only) | fwd start songbird  (claim daemon) | fwd start songbird fsp  (FSP daemon only)" >&2
    echo "       reward onboarding: fwd onboard rewards --identity 0x.. --recipient 0x.. --networks songbird" >&2
    echo "       (guided stack onboarding: fwd custody + clif env + nonce seeding)" >&2
    echo "       output is compact by default; add --guided (or FWD_OUTPUT=guided) to onboard for the walk-through" >&2
    echo "       (upgrade|backup: Phase 1 — see docs/one-command-install.md)" >&2
    [ "$cmd" = "" ] && exit 2 || exit 0
    ;;
  *)
    echo "fwd: unknown command '$cmd' (try: fwd help)" >&2
    exit 2
    ;;
esac
