#!/bin/sh
# Host `fwd` lifecycle wrapper — Compose is an implementation detail of these.
# Installed to /usr/local/bin/fwd by install.sh.
#
# Operates from $FWD_DIR (default /opt/fwd), which holds the compose bundle +
# fetched source. The `--with-clif` overlay is included automatically when
# docker-compose.clif.yml is present + clif is installed ($CLIF_SRC exists).
#
#   sudo fwd start [<net>] | stop | restart | status | logs
#
# `fwd start` brings up fwd (+ litestream) only; `fwd start <net>`
# (flare|songbird|coston2) adds that network's clif CLAIM daemon; `fwd start <net> fsp`
# also starts the FSP auto-signer (opt-in; requires FSP_AUTO_ENABLED=true).
#
# `upgrade` and `backup` are finalized with install.sh in Phase 1 (they need the
# release-manifest fetch + the documented restore runbook); stubbed here so the
# command contract is visible and honest.
set -eu

FWD_DIR="${FWD_DIR:-/opt/fwd}"
CLIF_SRC="${CLIF_SRC:-/opt/fwd/clif}"
cd "$FWD_DIR"

COMPOSE="-f docker-compose.yml"
[ -d "$CLIF_SRC" ] && [ -f docker-compose.clif.yml ] && COMPOSE="$COMPOSE -f docker-compose.clif.yml"
# clif build context + env live at the install root; export so the overlay
# resolves them (the wrappers run compose from the bundle dir, not the root).
export CLIF_SRC CLIF_ENV="${CLIF_ENV:-$CLIF_SRC/.env}"

cmd="${1:-}"
[ "$#" -gt 0 ] && shift

case "$cmd" in
  start)
    # `fwd start` = fwd (+ litestream) only. `fwd start <net>` adds that network's CLAIM
    # daemon. `fwd start <net> fsp` ALSO starts the FSP auto-signer (only meaningful with
    # FSP_AUTO_ENABLED=true in .env.<net> — clif refuses + exits otherwise).
    case "${1:-}" in
      flare|songbird|coston2)
        _net="$1"; shift
        if [ "${1:-}" = fsp ]; then shift; exec docker compose $COMPOSE --profile "$_net" --profile "$_net-fsp" up -d "$@"; fi
        exec docker compose $COMPOSE --profile "$_net" up -d "$@"
        ;;
      *) exec docker compose $COMPOSE up -d "$@" ;;
    esac
    ;;
  stop)    exec docker compose $COMPOSE stop "$@" ;;
  restart) exec docker compose $COMPOSE restart "$@" ;;
  status)  exec docker compose $COMPOSE ps "$@" ;;
  logs)    exec docker compose $COMPOSE logs "$@" ;;
  onboard) exec env FWD_DIR="$FWD_DIR" FWD_CONTAINER="${FWD_CONTAINER:-fwd}" CLIF_SRC="$CLIF_SRC" CLIF_ENV="$CLIF_ENV" "$FWD_DIR/install/onboard" "$@" ;;
  upgrade|backup)
    echo "fwd $cmd: finalized with install.sh in Phase 1 — see docs/one-command-install.md" >&2
    exit 2
    ;;
  ""|help|-h|--help)
    echo "usage: fwd {start [<net> [fsp]]|stop|restart|status|logs|onboard} [args...]" >&2
    echo "       fwd start  (fwd only) | fwd start songbird  (+ claim) | fwd start songbird fsp  (+ FSP auto-signer)" >&2
    echo "       reward onboarding: fwd onboard rewards --identity 0x.. --recipient 0x.. --networks songbird" >&2
    echo "       (guided stack onboarding: fwd custody + clif env + nonce seeding)" >&2
    echo "       (upgrade|backup: Phase 1 — see docs/one-command-install.md)" >&2
    [ "$cmd" = "" ] && exit 2 || exit 0
    ;;
  *)
    echo "fwd: unknown command '$cmd' (try: fwd help)" >&2
    exit 2
    ;;
esac
